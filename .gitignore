# =========================================================================
# NEXA Platform - Root .gitignore
# =========================================================================

# Java & Maven
**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/*.nar
.mvn/wrapper/maven-wrapper.jar

# Node & Next.js
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
.env*.local

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editors
.idea/
*.iml
*.iws
.vscode/
.settings/
.project
.classpath
*.sublime-project
*.sublime-workspace

# OS Files
.DS_Store
Thumbs.db
ehthumbs.db

# Database files
*.db
*.sqlite
*.h2.db
